[Unit]
Description=WellDungeon VK Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/welldungeon_stats
ExecStart=/usr/bin/python3 /root/welldungeon_stats/bot.py
Restart=always
RestartSec=10
Environment="PYTHONUNBUFFERED=1"

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target